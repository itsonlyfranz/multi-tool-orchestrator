# Copy to .env (gitignored) and fill in. Only needed for live LLM planning
# (`orchestrator run ...`); the demo and the test suite run fully offline.
ANTHROPIC_API_KEY=
# Model used for planning, synthesis and the optional LLM arbiter.
ORCH_MODEL=claude-sonnet-5-5
# Optional tuning
ORCH_MAX_CONCURRENCY=8
ORCH_STEP_TIMEOUT=30
# ORCH_AUDIT_PATH=./audit.jsonl
# ORCH_WORKSPACE=./workspace
